//@version=6
indicator("GOLD SNIPER PRO - Webhook Connection Test", overlay=true)

// CONNECTION TEST ONLY.
// This EMA-cross example verifies delivery to your webhook receiver.
// It is NOT the production ICT/SMC strategy and must not be used as a trading system.

fastLen = input.int(9, "Fast EMA", minval=1)
slowLen = input.int(21, "Slow EMA", minval=2)
scoreDemo = input.int(90, "Test score (demo)", minval=0, maxval=100)
riskTicks = input.int(100, "Demo stop distance in ticks", minval=1)
rewardR = input.float(2.0, "Demo target RR", minval=1.0, step=0.25)

fast = ta.ema(close, fastLen)
slow = ta.ema(close, slowLen)
longSignal = ta.crossover(fast, slow) and barstate.isconfirmed
shortSignal = ta.crossunder(fast, slow) and barstate.isconfirmed

tick = syminfo.mintick
if longSignal or shortSignal
    isLong = longSignal
    entry = close
    stop = isLong ? entry - riskTicks * tick : entry + riskTicks * tick
    tp1 = isLong ? entry + riskTicks * tick : entry - riskTicks * tick
    tp2 = isLong ? entry + riskTicks * tick * rewardR : entry - riskTicks * tick * rewardR
    tp3 = isLong ? entry + riskTicks * tick * rewardR * 1.5 : entry - riskTicks * tick * rewardR * 1.5
    signalId = syminfo.ticker + "-" + timeframe.period + "-" + str.tostring(time)
    msg = '{"signal_id":"' + signalId + '","symbol":"' + syminfo.ticker + '","direction":"' + (isLong ? "LONG" : "SHORT") + '","timeframe":"' + timeframe.period + '","entry":' + str.tostring(entry, format.mintick) + ',"sl":' + str.tostring(stop, format.mintick) + ',"tp1":' + str.tostring(tp1, format.mintick) + ',"tp2":' + str.tostring(tp2, format.mintick) + ',"tp3":' + str.tostring(tp3, format.mintick) + ',"score":' + str.tostring(scoreDemo) + ',"timestamp":' + str.tostring(time) + '}'
    alert(msg, alert.freq_once_per_bar_close)

plot(fast, "Fast EMA", color=color.aqua)
plot(slow, "Slow EMA", color=color.orange)
plotshape(longSignal, title="Test BUY", style=shape.labelup, location=location.belowbar, color=color.green, text="TEST BUY")
plotshape(shortSignal, title="Test SELL", style=shape.labeldown, location=location.abovebar, color=color.red, text="TEST SELL")
